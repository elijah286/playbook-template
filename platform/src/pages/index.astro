---
import { ArrowRight, Layers, MessageSquare } from '@lucide/astro';
import Shell from '../layouts/Shell.astro';
import ResourceCard from '../components/ResourceCard.astro';
import PlaybookDirectory from '../components/PlaybookDirectory.astro';
import { config as hubConfig, resources as allResources, playbooks, legacy, bookHref, previewUrl } from '../data.mjs';
const { book = legacy ? playbooks[0] : null } = Astro.props;
const config = book?.config ?? hubConfig;
const resources = book?.resources ?? allResources;
const href = route => bookHref(book, route);
const featured = resources.filter(resource => resource.featured).sort((left, right) => Number(Boolean(previewUrl(right))) - Number(Boolean(previewUrl(left)))).slice(0, 3);
const copy = {
  featuredHeading: 'Recommended Starting Points',
  primaryAction: 'Browse Resources',
  secondaryAction: 'Find Your Audience',
  audienceDescription: 'For sales, field application engineering, and customer success teams, with shared resources for partners and customers.',
  ...config.overview,
};
---
<Shell active="overview" book={book}>
  {book ? <>
  <section class="hero-band">
    <div class="hero-inner"><div class="eyebrow"><span></span>{config.publication.mode === 'public-demo' ? 'REFERENCE PLAYBOOK' : 'CUSTOMER VALUE PLAYBOOK'}<span class="edition">{config.edition ?? '01'}</span></div>
      <h1>{config.name}</h1><p class="hero-thesis">{config.valueThesis}</p>
      <p class="hero-audience">{copy.audienceDescription}</p>
      <div class="hero-actions"><a class="button" href={href('library/')}>{copy.primaryAction}<ArrowRight size={19} /></a><a class="text-link" href={href('paths/')}>{copy.secondaryAction}<ArrowRight size={18} /></a><a class="text-link" href={href('community/')}><MessageSquare size={18} />Contribute &amp; Ask</a></div>
    </div>
  </section>
  <section class="content-section featured-section"><div class="section-heading"><div><p class="eyebrow">CURATED STARTING POINTS</p><h2>{copy.featuredHeading}</h2></div><a class="text-link" href={href('library/')}>Resource Library<ArrowRight size={16} /></a></div>{featured.length ? <div class="resource-grid">{featured.map(resource => <ResourceCard resource={resource} book={book} />)}</div> : <div class="empty-state"><Layers size={30} /><h3>No Curated Resources Yet</h3><p>The playbook owner has not selected any featured resources.</p><a class="button" href={href('contribute/')}>Add a Resource<ArrowRight size={17} /></a></div>}</section>
  </> : <PlaybookDirectory />}
</Shell>