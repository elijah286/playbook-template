---
import { Upload, FileText, Plus, ArrowUpRight, ArrowRight } from '@lucide/astro';
import Shell from '../layouts/Shell.astro';
import { repositoryUrl, config, playbooks, bookHref, legacy } from '../data.mjs';
const { book = null } = Astro.props;
const path = book && !book.legacy ? `playbooks/${book.slug}/resources` : 'resources';
const form = repositoryUrl ? `${repositoryUrl}/issues/new?template=resource.yml${book && !book.legacy ? `&playbook=${book.slug}` : ''}` : null;
---
<Shell title="Contribute" book={book}>
	<section class="page-heading"><p class="eyebrow">{book?.config.name ?? 'CONTRIBUTOR AREA'}</p><h1>{book ? 'Contribute a Resource' : 'Build the Shared Playbook Collection'}</h1><p>Resources, questions, and practical examples for the approved playbook audience.</p></section>
	{!book && !legacy && playbooks.length > 0 && <section class="content-section contribution-playbooks"><h2>Choose a Playbook</h2><ul>{playbooks.map(candidate => <li><a class="text-link" href={bookHref(candidate, 'contribute/')}>{candidate.config.name}<ArrowRight size={17} /></a></li>)}</ul></section>}
	<section class="contribution-grid">
		{(book || legacy) && <article><Upload size={29} /><h2>Upload Materials</h2><p>Presentations, guides, email templates, and source files approved for this audience.</p>{repositoryUrl && <a class="button" href={`${repositoryUrl}/upload/main/${path}`} rel="noreferrer">Upload in GitHub<ArrowUpRight size={16} /></a>}<p class="access-notice">{config.publication.mode === 'public-demo' ? 'Public-demo downloads include embedded notes and hidden slides. Never upload confidential material.' : 'Every repository reader can inspect committed files and their history, including drafts.'}</p></article>}
		{(book || legacy) && <article><FileText size={29} /><h2>Request or Manage Content</h2><p>Propose guidance, an email template, code, or a linked video. Requests remain drafts until reviewed.</p>{form && <a class="button button-outline" href={form} rel="noreferrer">Open Resource Form<ArrowUpRight size={16} /></a>}{repositoryUrl && <a class="text-link" href={`${repositoryUrl}/tree/main/${path}`} rel="noreferrer">Manage Resources<ArrowUpRight size={16} /></a>}</article>}
		<article><Plus size={29} /><h2>Add a Playbook</h2><p>A new topic with its own resources, audience guidance, and maintainer.</p>{repositoryUrl && <a class="button button-outline" href={`${repositoryUrl}/actions/workflows/add-playbook.yml`} rel="noreferrer">Create Playbook Draft<ArrowUpRight size={16} /></a>}<p class="access-notice">All playbooks in this hub share the same reader access. Differently restricted content needs a separate protected destination.</p></article>
	</section>
</Shell>