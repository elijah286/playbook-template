---
import { ArrowLeft, ArrowUpRight, Download, MessageSquare, CheckCircle2, FileText, ExternalLink } from '@lucide/astro';
import Shell from '../../layouts/Shell.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resources, audiences, categories, href, assetUrl, html, repositoryUrl, resourceUrl } from '../../data.mjs';
export function getStaticPaths() { return resources.flatMap(resource => [{ params: { id: resource.id }, props: { resource } }, ...resource.aliases.map(id => ({ params: { id }, props: { resource, alias: true } }))]); }
const { resource, alias } = Astro.props;
if (alias) return Astro.redirect(resourceUrl(resource));
const related = resources.filter(candidate => resource.relatedResources.includes(candidate.id));
---
<Shell active="library" title={resource.title}>
  <section class="resource-heading"><a class="text-link" href={href('library/')}><ArrowLeft size={16} />Resource Library</a><p class="eyebrow">{resource.type.replace(/-/g, ' ')}</p><h1>{resource.title}</h1><p>{resource.summary}</p></section>
  <section class="resource-detail"><article class="resource-body">{resource.content ? <div class="prose" set:html={html(resource.content)} /> : <div class="presentation-preview"><FileText size={56} /><p class="eyebrow">ORIGINAL SOURCE MATERIAL</p><h2>{resource.title}</h2><p>{resource.keyMessages ?? 'Download the original presentation. Slide text, speaker notes, and hidden slides are not indexed or converted into a web preview.'}</p><a class="button" href={assetUrl(resource)} download><Download size={19} />Download {resource.extension.slice(1).toUpperCase()}</a><p class="file-caption">{(resource.size / 1000000).toFixed(1)} MB · Original file</p></div>}{resource.links?.length > 0 && <div class="reference-links"><h2>References and Next Steps</h2>{resource.links.map(link => <a href={link.url} rel="noreferrer noopener"><span>{link.title}</span><ExternalLink size={16} /></a>)}</div>}{related.length > 0 && <section class="related-resources"><h2>Continue the Path</h2><div class="resource-grid">{related.map(candidate => <ResourceCard resource={candidate} />)}</div></section>}</article>
    <aside class="resource-facts"><p class="eyebrow">RESOURCE DETAILS</p><dl><dt>Intended Audience</dt><dd>{resource.audiences.map(audience => audiences[audience]).join(', ')}</dd><dt>Content Category</dt><dd>{resource.categories.map(category => categories[category]).join(', ')}</dd><dt>Owner</dt><dd>{resource.owner}</dd><dt>Review Status</dt><dd>{resource.reviewStatus ?? 'Public distribution approved; technical review not recorded'}</dd>{resource.reviewDate && <><dt>Reviewed</dt><dd>{resource.reviewDate}</dd></>}{resource.duration && <><dt>Duration</dt><dd>{resource.duration}</dd></>}{resource.prerequisites && <><dt>Prerequisites</dt><dd>{resource.prerequisites}</dd></>}</dl><a class="button button-outline" href={assetUrl(resource)} download><Download size={16} />Original File</a>{repositoryUrl && <a class="text-link" href={`${repositoryUrl}/discussions`} rel="noreferrer"><MessageSquare size={16} />Discuss This Resource<ArrowUpRight size={14} /></a>}<details class="provenance"><summary>Source and Provenance</summary><p>{resource.provenance?.description ?? 'Authored for this playbook instance.'}</p>{resource.provenance?.url && <a href={resource.provenance.url} rel="noreferrer">Source Repository<ArrowUpRight size={14} /></a>}{resource.provenance?.revision && <p class="hash">Revision: {resource.provenance.revision}</p>}<p class="hash">SHA-256: {resource.sha256}</p></details></aside>
  </section>
</Shell>