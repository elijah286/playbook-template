---
import { ArrowLeft, ArrowUpRight, Download, MessageSquare } from '@lucide/astro';
import Shell from '../../layouts/Shell.astro';
import ResourceBody from '../../components/ResourceBody.astro';
import { resources as allResources, audiences, categories, bookHref, assetUrl, repositoryUrl, resourceUrl as scopedResourceUrl, playbooks } from '../../data.mjs';
export function getStaticPaths() { return allResources.flatMap(resource => [{ params: { id: resource.id }, props: { resource } }, ...resource.aliases.map(id => ({ params: { id }, props: { resource, alias: true } })), ...(playbooks.find(book => book.slug === resource.playbook)?.config.legacyResourceRoutes ? [resource.localId, ...resource.localAliases].map(id => ({ params: { id }, props: { resource, alias: true } })) : [])]); }
const { resource, alias, book = playbooks.find(candidate => candidate.slug === resource.playbook) ?? null } = Astro.props;
const resources = book?.resources ?? allResources;
const href = route => bookHref(book, route);
const resourceUrl = candidate => scopedResourceUrl(candidate, book);
if (alias) return Astro.redirect(resourceUrl(resource));
const related = resources.filter(candidate => resource.relatedResources.includes(candidate.id));
const reviewStatus = resource.reviewStatus ?? (resource.publicApproved ? 'Public distribution approved; technical review not recorded' : 'Technical review not recorded');
---
<Shell active="library" title={resource.title} book={book}>
  <section class="resource-heading"><a class="text-link" href={href('library/')}><ArrowLeft size={16} />Resource Library</a><p class="eyebrow">{resource.type.replace(/-/g, ' ')}</p><h1>{resource.title}</h1><p>{resource.summary}</p></section>
  <section class="resource-detail"><ResourceBody resource={resource} book={book} related={related} />
    <aside class="resource-facts"><p class="eyebrow">RESOURCE DETAILS</p><dl><dt>Intended Audience</dt><dd>{resource.audiences.map(audience => audiences[audience]).join(', ')}</dd><dt>Content Category</dt><dd>{resource.categories.map(category => categories[category]).join(', ')}</dd><dt>Owner</dt><dd>{resource.owner}</dd><dt>Review Status</dt><dd>{reviewStatus}</dd>{resource.reviewDate && <><dt>Reviewed</dt><dd>{resource.reviewDate}</dd></>}{resource.duration && <><dt>Duration</dt><dd>{resource.duration}</dd></>}{resource.prerequisites && <><dt>Prerequisites</dt><dd>{resource.prerequisites}</dd></>}</dl><a class="button button-outline" href={assetUrl(resource)} download><Download size={16} />Original File</a>{repositoryUrl && <a class="text-link" href={`${repositoryUrl}/discussions`} rel="noreferrer"><MessageSquare size={16} />Discuss This Resource<ArrowUpRight size={14} /></a>}<details class="provenance"><summary>Source and Provenance</summary><p>{resource.provenance?.description ?? 'Authored for this playbook instance.'}</p>{resource.provenance?.url && <a href={resource.provenance.url} rel="noreferrer">Source Repository<ArrowUpRight size={14} /></a>}{resource.provenance?.revision && <p class="hash">Revision: {resource.provenance.revision}</p>}<p class="hash">SHA-256: {resource.sha256}</p></details></aside>
  </section>
</Shell>