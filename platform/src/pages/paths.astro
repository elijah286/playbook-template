---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import Shell from '../layouts/Shell.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { resources as allResources, audiences, bookHref, config as hubConfig } from '../data.mjs';
const { book = null } = Astro.props;
const resources = book?.resources ?? allResources;
const config = book?.config ?? hubConfig;
const href = route => bookHref(book, route);
---
<Shell active="paths" title="Audience Paths" book={book}><section class="page-heading"><p class="eyebrow">AUDIENCE PATHS</p><h1>Your Role. A Clear Next Step.</h1><p>A shared resource library, curated around the work you need to do.</p></section><div class="audience-tabs" role="group" aria-label="Choose an audience">{Object.entries(audiences).map(([key, label]) => <a href={`?audience=${key}`} data-audience={key}>{label}</a>)}</div>{Object.entries(audiences).map(([key, label]) => <section class="content-section audience-section" data-path={key}><div class="section-heading"><div><p class="eyebrow">{label}</p><h2>{config.audienceGuidance?.[key] ?? 'Start With the Relevant Resources.'}</h2></div><a class="text-link" href={href(`library/?audience=${key}`)}>Browse All<ArrowRight size={16} /></a></div><div class="resource-grid">{resources.filter(resource => resource.audiences.includes(key)).slice(0, 6).map(resource => <ResourceCard resource={resource} book={book} />)}</div>{!resources.some(resource => resource.audiences.includes(key)) && <p class="muted">No resources have been published for this audience yet.</p>}</section>)}<script>const audience = new URLSearchParams(location.search).get('audience'); if (audience && document.querySelector(`[data-path="${CSS.escape(audience)}"]`)) { document.querySelectorAll('[data-path]').forEach(section => { section.hidden = section.dataset.path !== audience; }); document.querySelector(`[data-audience="${CSS.escape(audience)}"]`)?.setAttribute('aria-current', 'true'); }</script></Shell>