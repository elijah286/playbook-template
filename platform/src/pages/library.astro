---
import { Search, SlidersHorizontal, ArrowUpRight, X, FileText } from '@lucide/astro';
import Shell from '../layouts/Shell.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { resources as allResources, categories, audiences, bookHref, href, playbooks, legacy } from '../data.mjs';
const { book = null } = Astro.props;
const resources = book?.resources ?? allResources;
const scopedHref = route => bookHref(book, route);
const types = [...new Set(resources.map(resource => resource.type))].sort();
---
<Shell active="library" title="Resource Library" book={book}>
  <section class="page-heading"><p class="eyebrow">{book ? book.config.name : legacy ? 'THE RESOURCE LIBRARY' : 'ALL PLAYBOOKS'}</p><h1>{book || legacy ? 'Resource Library' : 'All Resources'}</h1><p>Presentations, email templates, practical guidance, code, and videos.</p>{book && !book.legacy && <a class="text-link" href={href('library/')}>Search All Playbooks<ArrowUpRight size={16} /></a>}</section>
  <section class="library-layout" data-index={scopedHref('search.json')}>
    <button class="button button-outline filter-toggle" type="button" aria-expanded="false" aria-controls="resource-filters"><SlidersHorizontal size={17} />Filters</button>
    <aside id="resource-filters" class="filter-sidebar"><h2><SlidersHorizontal size={18} />Refine Resources</h2>{!book && !legacy && <fieldset><legend>Playbook</legend>{playbooks.map(candidate => <label><input type="checkbox" name="playbook" value={candidate.slug} />{candidate.config.name}</label>)}</fieldset>}<fieldset><legend>Audience</legend>{Object.entries(audiences).map(([key, label]) => <label><input type="checkbox" name="audience" value={key} />{label}</label>)}</fieldset><fieldset><legend>Resource Type</legend>{types.map(type => <label><input type="checkbox" name="type" value={type} />{type.replace(/-/g, ' ')}</label>)}</fieldset><fieldset><legend>Content Category</legend>{Object.entries(categories).map(([key, label]) => <label><input type="checkbox" name="category" value={key} />{label}</label>)}</fieldset><button class="text-link clear-filters" type="button"><X size={15} />Clear Filters</button></aside>
    <div class="library-main"><form class="search-form" role="search"><Search size={21} /><label class="sr-only" for="resource-search">{book || legacy ? 'Search this playbook' : 'Search all playbooks'}</label><input id="resource-search" type="search" name="q" placeholder="Search resources, topics, or outcomes" autocomplete="off" /><button type="submit" class="icon-button" aria-label="Search" title="Search"><ArrowUpRight size={19} /></button></form><div class="results-heading"><p id="result-count" role="status" aria-live="polite">{resources.length} resources</p><span>{book || legacy ? 'THIS PLAYBOOK ONLY' : 'ALL PLAYBOOKS'}</span></div><div id="resource-results" class="resource-grid">{resources.map(resource => <ResourceCard resource={resource} book={book} />)}</div><div id="no-results" class="empty-state" hidden><Search size={30} /><h2>No Matching Resources</h2><p>Try another search or clear the selected filters.</p><button class="button clear-filters" type="button">Clear Search and Filters<X size={17} /></button></div><p class="search-error" role="alert" hidden>Search could not load. The complete resource library remains available below.</p><noscript><p>Search needs JavaScript. All published resources are listed below.</p></noscript></div>
  </section>
  <script>
    import MiniSearch from 'minisearch';
    const surface = document.querySelector('.library-layout');
    const results = document.getElementById('resource-results');
    const cards = new Map([...results.querySelectorAll<HTMLElement>('[data-resource-id]')].map(card => [card.dataset.resourceId, card]));
    const count = document.getElementById('result-count');
    const empty = document.getElementById('no-results');
    const input = document.getElementById('resource-search');
    const controls = [...document.querySelectorAll('.filter-sidebar input')];
    const form = document.querySelector('.search-form');
    const filterToggle = document.querySelector('.filter-toggle');
    filterToggle.addEventListener('click', () => {
      const open = filterToggle.getAttribute('aria-expanded') !== 'true';
      filterToggle.setAttribute('aria-expanded', String(open));
      document.getElementById('resource-filters').dataset.open = String(open);
    });
    const search = new MiniSearch({ fields: ['title', 'summary', 'body', 'terms'], storeFields: ['title', 'summary', 'type', 'audiences', 'categories', 'url'], searchOptions: { boost: { title: 4, summary: 2 }, prefix: true, fuzzy: 0.2 } });
    let documents = [];
    function update() {
      const query = input.value.trim();
      const selections = Object.fromEntries(['audience', 'type', 'category', 'playbook'].map(name => [name, controls.filter(control => control.name === name && control.checked).map(control => control.value)]));
      const matches = query ? search.search(query).map(result => documents.find(document => document.id === result.id)) : documents;
      const filtered = matches.filter(resource => (!selections.audience.length || selections.audience.some(audience => resource.audiences.includes(audience))) && (!selections.type.length || selections.type.includes(resource.type)) && (!selections.category.length || selections.category.some(category => resource.categories.includes(category))) && (!selections.playbook.length || selections.playbook.some(slug => resource.playbooks.includes(slug))));
      results.replaceChildren(...filtered.map(resource => cards.get(resource.id)).filter(Boolean));
      count.textContent = `${filtered.length} ${filtered.length === 1 ? 'resource' : 'resources'}${query ? ` for "${query}"` : ''}`;
      empty.hidden = filtered.length !== 0;
      const parameters = new URLSearchParams();
      if (query) parameters.set('q', query);
      for (const [name, values] of Object.entries(selections)) for (const value of values) parameters.append(name, value);
      history.replaceState(null, '', location.pathname + (parameters.size ? `?${parameters}` : ''));
    }
    try {
      const response = await fetch(surface.dataset.index);
      if (!response.ok) throw new Error('Index unavailable');
      documents = await response.json();
      search.addAll(documents);
      const parameters = new URLSearchParams(location.search);
      input.value = parameters.get('q') ?? '';
      for (const control of controls) control.checked = parameters.getAll(control.name).includes(control.value);
      update();
      surface.dataset.ready = 'true';
      input.addEventListener('input', update);
      controls.forEach(control => control.addEventListener('change', update));
      form.addEventListener('submit', event => { event.preventDefault(); update(); });
      document.querySelectorAll('.clear-filters').forEach(button => button.addEventListener('click', () => { input.value = ''; controls.forEach(control => { control.checked = false; }); update(); input.focus(); }));
    } catch { document.querySelector('.search-error').hidden = false; }
  </script>
</Shell>