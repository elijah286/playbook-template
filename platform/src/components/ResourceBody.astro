---
import { Download, Copy, ExternalLink, FileText } from '@lucide/astro';
import ResourceCard from './ResourceCard.astro';
import { html, assetUrl, fileUrl, slideUrls, previewUrl, resourceUrl } from '../data.mjs';
const { resource, book = null, related = [] } = Astro.props;
if (resource.type === 'email-template' && !resource.source) resource.source = resource.content;
const slides = slideUrls(resource);
---
<article class="resource-body">
  {resource.source ? <section class="source-preview"><div class="source-toolbar"><span>{resource.type === 'email-template' ? 'Email Template' : resource.relative}</span><button class="icon-button" type="button" data-copy-text={resource.source} aria-label={resource.type === 'email-template' ? 'Copy email template' : 'Copy source code'} title={resource.type === 'email-template' ? 'Copy email template' : 'Copy source code'}><Copy size={17} /></button></div><pre class:list={{ 'email-source': resource.type === 'email-template' }}><code>{resource.source}</code></pre><p class="copy-status" role="status" aria-live="polite"></p></section> : resource.content ? <div class="prose" set:html={html(resource.content)} /> : slides.length ? <div class="presentation-material"><a class="preview-trigger" href={resourceUrl(resource, book)} data-slide-preview data-slides={JSON.stringify(slides)} data-title={resource.title} data-download={assetUrl(resource)} aria-label={`Preview slides: ${resource.title}`} aria-haspopup="dialog" title={`Preview ${slides.length} slides`}><img class="resource-cover" src={previewUrl(resource)} alt="" width="1440" height="810" /><span class="preview-caption">Preview Presentation<span>{slides.length} slides</span></span></a>{resource.keyMessages && <p>{resource.keyMessages}</p>}<a class="button" href={assetUrl(resource)} download><Download size={19} />Download {resource.extension.slice(1).toUpperCase()}</a><p class="file-caption">{(resource.size / 1000000).toFixed(1)} MB · Original file</p></div> : <div class="presentation-preview"><FileText size={42} /><h2>{resource.title}</h2><a class="button" href={assetUrl(resource)} download><Download size={19} />Download {resource.extension.slice(1).toUpperCase()}</a></div>}
  {resource.links?.length > 0 && <div class="reference-links"><h2>{resource.type === 'video' ? 'Video' : 'References and Next Steps'}</h2>{resource.links.map(link => <a href={link.url} rel="noreferrer noopener"><span>{link.title}</span><ExternalLink size={16} /></a>)}</div>}
  {resource.files?.length > 0 && <section class="supporting-files"><h2>Source Files</h2>{resource.files.map((file, index) => <details class="source-file"><summary>{file.name}</summary><div class="source-toolbar"><a class="text-link" href={fileUrl(resource, index)} download={file.name}><Download size={16} />Download</a><button class="icon-button" type="button" data-copy-text={file.source} aria-label={`Copy ${file.name}`} title={`Copy ${file.name}`}><Copy size={17} /></button></div><pre><code>{file.source}</code></pre><p class="copy-status" role="status" aria-live="polite"></p></details>)}</section>}
  {related.length > 0 && <section class="related-resources"><h2>Continue the Path</h2><div class="resource-grid">{related.map(candidate => <ResourceCard resource={candidate} book={book} />)}</div></section>}
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach(button => button.addEventListener('click', async () => {
    const status = button.closest('.source-preview, .source-file')!.querySelector<HTMLElement>('.copy-status')!;
    try { await navigator.clipboard.writeText(button.dataset.copyText!); status.textContent = 'Copied.'; }
    catch { status.textContent = 'Copy unavailable. Select the text or download the original.'; }
  }));
</script>